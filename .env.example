# Copier ce fichier en .env.local et remplir les valeurs
# NE JAMAIS committer .env.local sur git

# Sanity (projet Elity Conseils). Ces valeurs ont aussi des defauts dans le code,
# mais il est recommande de les definir sur Vercel (Settings > Environment Variables).
NEXT_PUBLIC_SANITY_PROJECT_ID=3fi17iq8
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Token d'ecriture, UNIQUEMENT pour lancer le script de seed (scripts/seed-sanity.mjs).
# A creer sur sanity.io/manage > projet > API > Tokens (role Editor). Ne pas exposer publiquement.
SANITY_WRITE_TOKEN=
